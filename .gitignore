# --- Secrets (NEVER push to GitHub) ---
server/.env
.env
.env.local
.env.*.local
*.pem
*.key

# A copy of server/.env taken before an edit (scripts/dedupe-env-duplicates.js).
# None of the four rules above matches `.env.bak` — `.env` matches that name
# exactly and `.env.*.local` needs the `.local` suffix — so without this line a
# backup copy holding every secret would be an ordinary untracked file, one
# `git add -A` from the remote. Confirmed with `git check-ignore -v`.
server/.env.bak*

# Test-only mail drop: utils/mailer.js writes here when MAIL_TRANSPORT=file.
# These files contain live reset codes — never commit one.
server/tmp/

# --- Dependencies ---
node_modules/
server/node_modules/
web/node_modules/
mobile/node_modules/

# --- Build output ---
dist/
build/
.expo/
web-build/

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- OS / Editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Uploads (user files — local only) ---
server/uploads/*
!server/uploads/.gitkeep

# --- Database dumps / backups ---
*.sql.backup
server/backups/*
!server/backups/.gitkeep
*.dump

# --- Test / temp ---
coverage/
.nyc_output/
tmp/
temp/

# --- Smoke test (Playwright) ---
# Real login credentials for the read-only smoke run. The bare `.env` rule at
# the top of this file matches `client/.env` but NOT `.env.e2e`, so this line
# is load-bearing rather than belt-and-braces — verified with
# `git check-ignore` before the file was created.
client/e2e/.env.e2e

# 144 screenshots per run (36 URLs x 2 widths x 2 themes). Some show real
# seeded names and the backup filenames on Admin -> Backup & Restore.
client/e2e-out/

# --- Local agent tool settings and handoff notes (never committed) ---
# Untracked in the main checkout on 2026-11-03. Root only, exact names, so no
# real doc is caught by a wildcard.
/.agents/
/.codex/
/HANDOFF-CODEX.md
/REFERENCE-DOCS-PASS-AND-P4.md
/WORKLOG-SINCE-CLAUDE.md
