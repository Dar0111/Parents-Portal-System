# SMOKE-1 credentials — VARIABLE NAMES ONLY.
#
# Copy this file to `client/e2e/.env.e2e` and fill in the values. That file is
# gitignored (`.gitignore` → `client/e2e/.env.e2e`, verified with
# `git check-ignore` before it existed); THIS file is committed and must never
# gain a value.
#
# Nothing in the suite prints, logs or commits a value. A missing variable
# fails naming the VARIABLE — see `e2e/auth.js`.
#
# WHOSE ACCOUNTS: the admin, Nino's adviser, and Nino's parent. They are named
# that way in every test title and report, never by login id: a parent's
# login_id IS their child's LRN (§5c), and a test name ends up in terminals,
# logs and screenshots.
#
# The smoke run READS. It logs in and visits pages; it never clicks Save,
# Approve, Decline, Delete, Create backup, Restore or Mark all Present. The
# only write any of it causes is one `activity_logs` row per login, which is
# audit history and is never cleaned up.

E2E_ADMIN_ID=
E2E_ADMIN_PW=

E2E_TEACHER_ID=
E2E_TEACHER_PW=

E2E_PARENT_ID=
E2E_PARENT_PW=

# Optional overrides. Leave them unset unless a port has moved.
#
# The BROWSER must use `localhost`, not `127.0.0.1`: `server.js` allows exactly
# one CORS origin, `http://localhost:3000`, and a browser opened at
# 127.0.0.1 would send that as its Origin and have every API call refused.
# The readiness polls are Node fetch — no Origin, no CORS — and use 127.0.0.1
# on purpose.
#
# E2E_APP_ORIGIN=http://localhost:3000
# E2E_API_ORIGIN=http://127.0.0.1:5000
