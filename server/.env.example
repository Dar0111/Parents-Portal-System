# Copy to server/.env and fill it in. Never commit server/.env; never paste it.
# Every key below is one the server's code reads (2026-11-04). Placeholders only:
# blank means unset, so the code's default applies or the API refuses to start.
# Per command, never in this file: PORTAL_FIXTURE_HOSTED, PORTAL_DEMO_HOSTED,
# PORTAL_ACTIVITY_RESET and the four DEMO_* values (docs/DEMO_DATA.md).

# --- The API: server.js, utils/jwt.js, utils/corsOrigins.js ---
PORT=5000
# production on the VPS: a blank or default JWT_SECRET then stops the API.
NODE_ENV=
JWT_SECRET=
# Bare origins, comma-separated: no path, no trailing slash, never a *.
CORS_ORIGIN=http://localhost:3000
# Blank: the code's default token lifetime.
JWT_EXPIRES_IN=

# --- PostgreSQL: config/db.js ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=portal_app
PG_PASSWORD=
# The migrate role: db:setup, the restore and the ops scripts.
PG_MIGRATE_USER=portal_migrate
PG_MIGRATE_PASSWORD=
# disable, require or verify-full. Blank: disable on a loopback host, else verify-full.
PG_SSL=
# The project's CA certificate file; verify-full needs it.
PG_CA_FILE=

# --- Email: utils/mailer.js ---
# file: write each message under server/tmp/mail instead of sending (test:recovery).
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS: utils/smsTransport.js ---
# gateway or file. Blank: off.
SMS_TRANSPORT=
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
# At least 24 characters; the same passphrase as the phone's SMSGate app.
SMS_ENCRYPTION_PASSPHRASE=
