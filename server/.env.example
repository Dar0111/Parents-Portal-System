PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parents_portal

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h

# Browser origins allowed to call the API and open the socket — a COMMA-
# SEPARATED list (utils/corsOrigins.js). Each entry is a bare origin
# (http://host:port, no path, no trailing slash). A wildcard (*) is never
# accepted, even here. For the web in a phone's Chrome, add the laptop's LAN
# address beside localhost and restart the API:
#   CORS_ORIGIN=http://localhost:3000,http://<laptop IP>:3000
CORS_ORIGIN=http://localhost:3000

# Optional. Only needed if mysqldump is not on PATH — set to its full path.
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# --- Email (account recovery). Fill these in locally; NEVER commit values. ---
# Gmail with an App Password: host smtp.gmail.com, port 587, user = the
# full address, pass = the 16-character App Password (not the account
# password). SMTP_FROM is what recipients see.
# With these empty the server still starts and every other feature works;
# recovery emails simply cannot be sent, and the code says so once.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# TEST ONLY. Set to `file` and mail is written to server/tmp/mail/ instead
# of sent, so test:recovery can read a code no endpoint may ever return.
# Read ONCE at module load in utils/mailer.js and never from a request, so
# it cannot be switched on by anything arriving over HTTP. Leave it EMPTY
# here and set it only on a test command line.
MAIL_TRANSPORT=

# --- Text messages (account recovery by SMS). NEVER commit values. ---
# `gateway` posts to "SMS Gateway for Android" in LOCAL mode on the demo
# phone; `file` writes server/tmp/sms/ instead (tests only, like
# MAIL_TRANSPORT); empty means SMS is off and email is the only channel.
# SMS_GATEWAY_URL is http://<the phone's IP>:8080 — the IP can change with
# every hotspot session; check it with `npm run sms:probe`, and RESTART the
# API after changing it (read once at startup; --watch does not watch .env).
# USER / PASS are the Basic-auth credentials the app shows under Local Server.
SMS_TRANSPORT=
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
